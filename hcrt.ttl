@base <https://w3id.org/kim/hcrt/>.
@prefix dct: <http://purl.org/dc/terms/>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix vann: <http://purl.org/vocab/vann/> .


<scheme> a skos:ConceptScheme;
        dct:title "Hochschulcampus Ressourcentypen"@de, "Higher Education Resource Types"@en, "Brontypen voor het hoger onderwijs"@nl, "Типи ресурсів вищої освіти"@uk, "Typy zdrojů vyššího vzdělání"@cs, "Resurstyper för högre utbildning"@sv ;
        dct:description "Eine Wertelliste für Typen von Lernressourcen (Learning Resource Type), entstanden im Kontext des Metadatenschemas \"LOM for Higher Education OER Repositories\" (https://w3id.org/dini-ag-kim/hs-oer-lom-profil/latest/)."@de, "En värdelista för typer av lärresurser (Learning Resource Type), skapad i samband med metadataformatet \"LOM for Higher Education OER Repositories\" (https://w3id.org/dini-ag-kim/hs-oer-lom-profil/latest/)."@sv ;
        dct:publisher <https://oerworldmap.org/resource/urn:uuid:fd06253e-fe67-4910-b923-51db9d27e59f> ;
        dct:issued "2020-02-07" ;
        vann:preferredNamespaceUri "https://w3id.org/kim/hcrt/" ;
        vann:preferredNamespacePrefix "hcrt" ;
        dct:license <http://creativecommons.org/publicdomain/zero/1.0/> ;
        skos:hasTopConcept <application>, <assessment>, <audio>, <case_study>, <course>, <data>, <diagram>,
            <drill_and_practice>, <educational_game>, <experiment>, <image>, <index>, <lesson_plan>, <map>, 
            <portal>, <questionnaire>, <script>, <sheet_music>, <simulation>, <slide>, <text>, <textbook>, <video>, <web_page>,
            <worksheet>, <other> .

<application> a skos:Concept;
           skos:topConceptOf <scheme> ;
           skos:prefLabel "Softwareanwendung"@de, "Software Application"@en, "Computerprogramma"@nl, "Програмне забезпечення"@uk, "Počítačový program"@cs, "Application logicielle"@fr, "Programvara"@sv, "Aplicación de software"@es, "Softvérová aplikácia"@sk, "Εφαρμογή Λογισμικού"@el, "Applicazione Software"@it, "Ohjelmistosovellus"@fi ;
           skos:definition "A software application is software that can be directly executed by some processing unit."@en .

<assessment> a skos:Concept;
          skos:topConceptOf <scheme> ;
          skos:prefLabel "Lernkontrolle"@de, "Assessment"@en, "Evaluatie"@nl, "Оцінювання"@uk, "Hodnocení"@cs, "Contrôle d’apprentissage"@fr, "Bedömning"@sv, "Evaluación"@es, "Hodnotenie"@sk, "Αξιολόγηση"@el, "Valutazione"@it, "Arviointi"@fi ;
          skos:altLabel "Assessment"@de ;
          skos:scopeNote "unter anderem (Selbst-)Tests"@de, "entre autres (auto)tests"@fr ;
          skos:definition "The description of an activity or resource used to ensure attainment of a learning objective or learning outcome."@en .

<audio> a skos:Concept;
           skos:topConceptOf <scheme> ;
           skos:prefLabel "Audio"@de, "Audio Recording"@en, "Audio"@nl, "Аудіозапис"@uk, "Zvukový záznam"@cs,"Audio "@fr, "Ljudinspelning"@sv, "Grabación de audio"@es, "Zvukový záznam"@sk, "Ηχογράφηση"@el, "Registrazione Audio"@it, "Äänitallenne"@fi ;
           skos:altLabel "Tonaufnahme"@de, "Звукозапис"@uk, "Ljudinspelning"@sv ;
           skos:definition "A resource which mainly consists of aural Material."@en .

<case_study> a skos:Concept;
          skos:topConceptOf <scheme> ;
          skos:prefLabel "Fallstudie"@de, "Case Study"@en, "Casestudy"@nl, "Приклад"@uk, "Případová studie"@cs, "Étude de cas"@fr, "Fallstudie"@sv, "Caso de estudio"@es, "Prípadová štúdia"@sk, "Μελέτη Περίπτωσης"@el, "Caso Studio"@it, "Tapaustutkimus"@fi ;
          skos:definition "A description of an actual situation, commonly involving a decision, a challenge, an opportunity, a problem or an issue."@en .

<course> a skos:Concept;
          skos:topConceptOf <scheme> ;
          skos:prefLabel "Kurs"@de, "Course"@en, "Cursus"@nl, "Курс"@uk, "Kurz"@cs, "Cours"@fr, "Kurs"@sv, "Curso"@es, "Kurz"@sk, "Μάθημα"@el, "Corso"@it, "Kurssi"@fi ;
          skos:definition "An educational course comprises one or more educational events and/or creative works which aims to build knowledge, competence or ability of learners."@en .

<data> a skos:Concept;
          skos:topConceptOf <scheme> ;
          skos:prefLabel "Daten"@de, "Data"@en, "Gegevens"@nl, "Дані"@uk, "Données"@fr, "Data"@sv, "Datos"@es, "Dáta"@sk, "Δεδομένα"@el, "Dati"@it, "Data"@fi ;
          skos:scopeNote "unter anderem Roh- oder Beispieldaten"@de, "amongst others raw and example data"@en, "onder andere ruwe gegevens en voorbeeldgegevens"@nl, "включно з необробленими даними та зразками"@uk,  "entre autres, données brutes ou exemples"@fr, "bland annat rådata eller exempeldata"@sv ;
          skos:definition "Any form of digital representation, e.g. facts, measurements, recordings, records, or observations about the world. Data may be in any format or medium taking the form of writings, notes, numbers, symbols, text, images, films, video, sound recordings, pictorial reproductions, drawings, designs or other graphical representations, procedural manuals, forms, diagrams, work flow charts, equipment descriptions, data files, data processing algorithms, or statistical records."@en .

<diagram> a skos:Concept;
          skos:topConceptOf <scheme> ;
          skos:prefLabel "Diagramm"@de, "Diagram"@en, "Diagram"@nl, "Діаграма"@uk, "Diagram"@cs, "Diagramme"@fr, "Diagram"@sv, "Diagrama"@es, "Diagram"@sk, "Διάγραμμα"@el, "Diagramma"@it, "Kaavio"@fi ;
          skos:altLabel "Grafik"@de, "Графіка"@uk, "Grafik"@sv ;
          skos:definition "An image that illustrates the structure and/or its component substructures and/or relations with other structures by using lines, shapes, text, and other symbols."@en .

<drill_and_practice> a skos:Concept;
          skos:topConceptOf <scheme> ;
          skos:prefLabel "Übung"@de, "Drill and Practice"@en, "Oefening"@nl, "Практика"@uk, "Cvičení"@cs, "Exercice"@fr, "Övning"@sv, "Ejercicios prácticos"@es, "Cvičenie"@sk, "Άσκηση και Εξάσκηση"@el, "Esercizio e Pratica"@it, "Harjoittelu"@fi ;
          skos:definition "Exercise(s) or activities for the (repetitive) training of a skill or knowledge."@en .

<educational_game> a skos:Concept;
          skos:topConceptOf <scheme> ;
          skos:prefLabel "Lernspiel"@de, "Game"@en, "Educatief Spel"@nl, "Навчальна гра"@uk, "Hra"@cs, "Jeu éducatif"@fr, "Pedagogiskt spel"@sv, "Juego educativo"@es, "Vzdelávacia hra"@sk, "Εκπαιδευτικό Παιχνίδι"@el, "Gioco Educativo"@it, "Peli"@fi .

<experiment> a skos:Concept;
          skos:topConceptOf <scheme> ;
          skos:prefLabel "Experiment"@de, "Experiment"@en, "Experiment"@nl, "Експеримент"@uk, "Experiment"@cs, "Experiment"@cs, "Expérience"@fr, "Experiment"@sv, "Experimento"@es, "Experiment"@sk, "Πείραμα"@el, "Esperimento"@it, "Koe"@fi ;
          skos:definition "A scientific procedure undertaken to make a discovery, test a hypothesis, or demonstrate a known fact."@en .

<image> a skos:Concept;
          skos:topConceptOf <scheme> ;
          skos:prefLabel "Abbildung"@de, "Image"@en, "Afbeelding"@nl, "Ілюстрація"@uk, "Obrázek"@cs, "Illustration"@fr, "Bild"@sv, "Imagen"@es, "Obrázok"@sk, "Εικόνα"@el, "Immagine"@it, "Kuva"@fi ;
          skos:altLabel "Bild"@de, "Зображення"@uk, "Bild"@sv ;
          skos:scopeNote "Fotos, Grafiken und sonstige Bilder"@de, "photos, graphics, and other images"@en, "foto's, illustraties en andere afbeeldingen"@nl, "Фотографії, графіки та інші зображення"@uk, "Photos, graphiques et autres images"@fr, "Fotografier, grafik och andra bilder"@sv;
          skos:definition "A resource which mainly consists of (a) still image(s)."@en  .

<index> a skos:Concept;
          skos:topConceptOf <scheme> ;
          skos:prefLabel "Nachschlagewerk"@de, "Reference Work"@en, "Naslagwerk"@nl, "Довідник"@uk, "Ouvrage de référence"@fr, "Uppslagsverk"@sv, "Índice"@es, "Referenčné dielo"@sk, "Βιβλιογραφία"@el, "Opera di Riferimento"@it, "Hakuteos"@fi ;
          skos:scopeNote "zum Beispiel Glossar, Enzyklopädie, Lexikon"@de, "e.g.glossary, encyclopedia, dictionary"@en, "bijvoorbeeld woordenlijst, encyclopedie, lexicon"@nl, "наприклад, глосарій, енциклопедія, словник"@uk, "par exemple glossaire, encyclopédie, lexique"@fr, "till exempel ordlista, uppslagsverk, lexikon"@sv ;
          skos:definition "Material to be consulted for authoritative factual information, such as a dictionary, encyclopaedia, entry, handbook, standard, or field guide, or an informative web page such as an institutional, research group or project home page."@en .

<lesson_plan> a skos:Concept;
          skos:topConceptOf <scheme> ;
          skos:prefLabel "Unterrichtsplanung"@de, "Lesson Plan"@en, "Lesplan"@nl, "План уроку"@uk, "Plán lekce"@cs, "Plan de cours"@fr, "Lektionsplan"@sv, "Planificación de la clase"@es, "Plán vyučovacej hodiny"@sk, "Σχέδιο Μαθήματος"@el, "Piano di Lezione"@it, "Tuntisuunnitelma"@fi ;
          skos:definition "Detailed descriptions or outlines for a pedagogical session. Usually includes objective(s), instructional components or methods, and assessment."@en .

<map> a skos:Concept;
          skos:topConceptOf <scheme> ;
          skos:prefLabel "Karte"@de, "Map"@en, "Kaart"@nl, "Мапа"@uk, "Mapa"@cs, "Carte"@fr, "Karta"@sv, "Mapa"@es, "Mapa"@sk, "Χάρτης"@el, "Mappa"@it, "Kartta"@fi .

<portal> a skos:Concept;
          skos:topConceptOf <scheme> ;
          skos:prefLabel "Portal"@de, "Web Portal"@en, "Internetportaal"@nl, "Портал"@uk, "Webový portál"@cs, "Portail"@fr, "Webbportal"@sv, "Sitio web"@es, "Webový portál"@sk, "Διαδικτυακή Πύλη"@el, "Portale Web"@it, "Verkkoportaali"@fi ;
          skos:definition "A website that integrates applications, processes and services."@en .

<questionnaire> a skos:Concept;
          skos:topConceptOf <scheme> ;
          skos:prefLabel "Fragebogen"@de, "Questionnaire"@en, "Vragenlijst"@nl, "Анкета"@uk, "Questionnaire"@fr, "Enkät"@sv, "Cuestionario"@es, "Dotazník"@sk, "Ερωτηματολόγιο"@el, "Questionario"@it, "Kyselylomake"@fi ;
          skos:scopeNote "auch Rechercheauftrag und WebQuest"@de, "also research assignment and WebQuest"@en, "ook onderzoeksopdracht en WebQuest"@nl, "також дослідницьке завдання та веб-квест"@uk, "également mission de recherche et WebQuest"@fr, "även forskningsuppdrag och WebQuest"@sv ;
          skos:definition "A set of questions with a choice of answers, devised for the purposes of a survey or statistical study."@en .

<script> a skos:Concept;
          skos:topConceptOf <scheme> ;
          skos:prefLabel "Skript"@de, "Script"@en, "Script"@nl, "Запис"@uk, "Script"@fr, "Skript"@sv, "Guión"@es, "Skript"@sk, "Σενάριο"@el, "Script"@it, "Käsikirjoitus"@fi ;
          skos:scopeNote "zum Beispiel Vorlesungsskript"@de, "for example lecture notes"@en, "bijvoorbeeld collegedictaten"@nl, "наприклад конспект лекцій"@uk, "par exemple, script de cours"@fr, "till exempel föreläsningsanteckningar"@sv ;
          skos:definition "A script or scriptum is a textbook or study materials that include the content of a lecture series or course."@en .

<sheet_music> a skos:Concept ;
          skos:topConceptOf <scheme> ;
          skos:prefLabel "Musiknoten"@de, "Sheet Music"@en, "Bladmuziek"@nl, "Ноти"@uk, "Noty"@cs, "Partition de musique"@fr, "Noter"@sv, "Partitura"@es, "Noty"@sk, "Παρτιτούρα"@el, "Spartito Musicale"@it, "Nuotit"@fi .

<simulation> a skos:Concept;
          skos:topConceptOf <scheme> ;
          skos:prefLabel "Simulation"@de, "Simulation"@en, "Simulatie"@nl, "Симуляція"@uk, "Simulace"@cs, "Simulation"@fr, "Simulering"@sv, "Simulación"@es, "Simulácia"@sk, "Προσομοίωση"@el, "Simulazione"@it, "Simulaatio"@fi ;
          skos:definition "The reproducing of characteristics, conditions, and/or systems, often by the use of a model or a representation."@en .

<slide> a skos:Concept;
          skos:topConceptOf <scheme> ;
          skos:prefLabel "Präsentation"@de, "Presentation"@en, "Presentatie"@nl, "Презентація"@uk, "Prezentace"@cs, "Présentation"@fr, "Presentation"@sv, "Diapositiva"@es, "Prezentácia"@sk, "Παρουσίαση"@el, "Presentazione"@it, "Esitys"@fi ;
          skos:definition "A resource which mainly consists of slides."@en .

<text> a skos:Concept;
          skos:topConceptOf <scheme> ;
          skos:prefLabel "Textdokument"@de, "Text"@en, "Tekst"@nl, "Текстовий документ"@uk, "Document texte"@fr, "Textdokument"@sv, "Texto"@es, "Textový dokument"@sk, "Κείμενο"@el, "Testo"@it, "Teksti"@fi ;
          skos:scopeNote "zum Beispiel Artikel, Aufsatz, Abhandlung"@de, "for example article, essay"@en, "bijvoorbeeld artikel, opstel, verhandeling"@nl, "наприклад, стаття, есе, трактат"@uk, "par exemple article, dissertation, essai"@fr, "till exempel artikel, uppsats, avhandling"@sv ;
          skos:definition "A resource which mainly consists of written or writing materials."@en .

<textbook> a skos:Concept;
          skos:topConceptOf <scheme> ;
          skos:prefLabel "Lehrbuch"@de, "Textbook"@en, "Studieboek"@nl, "Підручник"@uk, "Učebnice"@cs, "Manuel"@fr, "Lärobok"@sv, "Libro de texto"@es, "Učebnica"@sk, "Διδακτικό Βιβλίο"@el, "Libro di Testo"@it, "Oppikirja"@fi ;
          skos:definition "Book used as standard work for the formal study of a particular subject."@en .

<video> a skos:Concept;
          skos:topConceptOf <scheme> ;
          skos:prefLabel "Video"@de, "Video"@en, "Video"@nl, "Відео"@uk, "Video"@cs, "Vidéo"@fr, "Video"@sv, "Vídeo"@es, "Video"@sk, "Βίντεο"@el, "Video"@it, "Video"@fi ;
          skos:definition "A resource which mainly consists of moving images."@en .

<web_page> a skos:Concept;
          skos:topConceptOf <scheme> ;
          skos:prefLabel "Webseite"@de, "Web Page"@en, "Webpagina"@nl, "Веб-сайт"@uk, "Webová stránka"@cs, "Site web"@fr, "Webbsida"@sv, "Página web"@es, "Webová stránka"@sk, "Ιστοσελίδα"@el, "Pagina Web"@it, "Verkkosivu"@fi ;
          skos:definition "A web page is an online document available (at least initially) on the world wide web."@en .

<worksheet> a skos:Concept;
          skos:topConceptOf <scheme> ;
          skos:prefLabel "Arbeitsmaterial"@de, "Worksheet"@en, "Werkblad"@nl, "Робочий матеріал"@uk, "Matériel de travail"@fr, "Arbetsmaterial"@sv, "Hoja de trabajo"@es, "Pracovný list"@sk, "Φύλλο Εργασίας"@el, "Scheda di Lavoro"@it, "Moniste"@fi ;
          skos:scopeNote "zum Beispiel Arbeitsblatt"@de, "наприклад робочий аркуш"@uk, "par exemple, feuille de travail"@fr, "till exempel arbetsblad"@sv ;
          skos:definition "A sheet containing exercises or tasks to be completed for the purpose of imparting knowledge, attitudes, or skills."@en .

<other> a skos:Concept;
          skos:topConceptOf <scheme> ;
          skos:prefLabel "Sonstiges"@de, "Other"@en, "Overigen"@nl, "Різне"@uk, "Jiné"@cs, "Divers"@fr, "Övrigt"@sv, "Otro"@es, "Iné"@sk, "Άλλο"@el, "Altro"@it, "Muu"@fi ;
          skos:definition "A learning resource type that is not covered by the other listed categories."@en .
